{
  "name": "everyday-gut-wellness",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.2.4",
  "scripts": {
    "dev": "tsx server.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test",
    "build": "node scripts/generate-pdf.mjs && vite build && node scripts/prerender.mjs && node scripts/validate-static-output.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=server-dist/server.cjs",
    "build:client": "node scripts/generate-pdf.mjs && vite build && node scripts/prerender.mjs && node scripts/validate-static-output.mjs",
    "validate:seo": "node scripts/validate-static-output.mjs",
    "start": "node server-dist/server.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@netlify/functions": "^6.1.1",
    "express": "^4.21.2",
    "lucide-react": "^1.63.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
