# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SENDER_API_TOKEN: Optional API token from Sender.net (Account Settings > API Access Tokens).
# When provided, all eBook subscribers will automatically sync to your Sender.net subscriber list.
# If omitted, subscribers are safely saved locally and can be downloaded as a CSV at /api/leads/export.csv.
SENDER_API_TOKEN=""

# SENDER_GROUP_ID: Optional Sender.net group/tag ID for segmenting eBook leads.
SENDER_GROUP_ID=""

# VITE_GUMROAD_PRODUCT_URL: Public Gumroad checkout URL for "The 30-Day Digestive Wellness Planner".
# Example: "https://yourbrand.gumroad.com/l/digestive-planner"
# If left empty, the website safely displays a "Coming Soon / Join Waitlist" button without broken checkouts.
VITE_GUMROAD_PRODUCT_URL=""

# ADMIN_ACCESS_KEY: Secret key required to access /api/leads and download CSV exports.
# Default: "gutwellness_admin_2026"
ADMIN_ACCESS_KEY="gutwellness_admin_2026"

