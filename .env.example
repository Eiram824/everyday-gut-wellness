# ==========================================
# EVERYDAY GUT WELLNESS - ENVIRONMENT CONFIG
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# For local or custom hosting, supply your Google AI Studio API key.
GEMINI_API_KEY="your_gemini_api_key_here"

# SUPABASE_URL: Supabase project URL used for durable subscriber storage. Required in production.
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Server-only secret. NEVER expose it as a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=""

# SENDER_API_TOKEN: Optional API token from Sender.net (Account Settings > API Access Tokens).
# When provided, free guide subscribers will automatically sync to your Sender.net contact list.
# If omitted, subscriber records are safely stored locally and exportable via CSV at /api/leads/export.csv.
SENDER_API_TOKEN=""

# SENDER_GROUP_ID: Optional Sender.net group/tag ID for segmenting eBook leads.
SENDER_GROUP_ID=""

# Public checkout URL for The 14-Day Gut Clarity Workbook (non-secret, configured in constants.ts).

# ADMIN_ACCESS_KEY: Secret key required to access /api/leads and download subscriber CSV exports.
# Required: If unset or empty, administrative endpoints will fail closed and reject all requests.
# Generate a strong, high-entropy secret string for production deployment.
ADMIN_ACCESS_KEY="your_custom_admin_access_key"
