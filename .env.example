# Server-only values. Configure production secrets in Netlify, never in Git.
# Never add VITE_ to an administrator, Supabase secret/service-role, or provider key.
# Empty private values fail closed until configured.

ADMIN_ACCESS_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Systeme.io: server-side requested-guide fulfillment only. Leave disabled until
# scripts/systeme-io-migration.sql and verified sender/delivery-rule QA are done.
# Create the tag named gut-reset-lead; put its NUMERIC ID below, not its name.
SYSTEME_IO_API_KEY=
SYSTEME_IO_TAG_ID=
SYSTEME_IO_ENABLED=false
SYSTEME_IO_GUIDE_DELIVERY_READY=false
# Optional public-facing native DOUBLE-OPT-IN form URL. No API contact creation
# or gut-reset-lead tagging is permission to start the seven-email marketing series.
SYSTEME_IO_MARKETING_OPT_IN_URL=

# Build-scope switch. Set true in the PRODUCTION deploy context only after
# everydaygutwellness.com and www have valid Netlify DNS and HTTPS.
CUSTOM_DOMAIN_REDIRECTS_ENABLED=false

# Optional server-side services
GEMINI_API_KEY=

# VITE_ variables are public. Use them only for intentionally public configuration.
