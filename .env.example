# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SENDER_API_TOKEN: Optional API token from Sender.net (Account Settings > API Access Tokens).
# When provided, all eBook subscribers will automatically sync to your Sender.net subscriber list.
# If omitted, subscribers are safely saved locally and can be downloaded as a CSV at /api/leads/export.csv.
SENDER_API_TOKEN=""

# SENDER_GROUP_ID: Optional Sender.net group/tag ID for segmenting eBook leads.
SENDER_GROUP_ID=""

