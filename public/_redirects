# Netlify Redirects Configuration
# 1. API routes redirected to Netlify Functions
/api/health            /.netlify/functions/health          200
/api/leads/export.csv  /.netlify/functions/leads-export    200
/api/leads             /.netlify/functions/leads           200

# 2. Unknown API routes return JSON 404 (does not swallow API errors)
/api/*                 /.netlify/functions/api-not-found   404

# 3. Single Page Application routing fallback
/*                     /index.html                         200
